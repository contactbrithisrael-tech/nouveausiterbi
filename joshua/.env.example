# ═══════════════════════════════════════════════════════════════
# Joshua — configuration
# Copier en .env puis renseigner. Le .env n'est JAMAIS versionné.
# ═══════════════════════════════════════════════════════════════

# ── Telegram ───────────────────────────────────────────────────
# Jeton donné par @BotFather (voir README, étape 1).
TELEGRAM_BOT_TOKEN=
# polling : aucune URL publique nécessaire, idéal en développement.
# webhook : exige TELEGRAM_WEBHOOK_URL en HTTPS et un secret.
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# ── Anthropic ──────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Le nom du modèle n'apparaît nulle part ailleurs dans le projet.
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_MAX_TOKENS=2048
ANTHROPIC_TEMPERATURE=0.2

# ── Qdrant ─────────────────────────────────────────────────────
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=joshua_documents
QDRANT_BATCH_SIZE=256

# ── PostgreSQL ─────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=joshua
POSTGRES_USER=joshua
POSTGRES_PASSWORD=changez-moi

# ── Redis ──────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
RATE_LIMIT_MESSAGES=20
RATE_LIMIT_WINDOW_SECONDS=60

# ── Embeddings ─────────────────────────────────────────────────
# fastembed = local et gratuit. Changer de modèle IMPOSE une réindexation
# complète (scripts/reindex.py --full) : les vecteurs ne sont pas comparables
# d'un modèle à l'autre.
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=64

# ── RAG ────────────────────────────────────────────────────────
# Candidats récupérés dans Qdrant, puis passages réellement envoyés à Claude.
# Les deux nombres n'ont aucune raison d'être égaux : voir app/ai/rag.py.
RAG_CANDIDATES=30
RAG_FINAL_CHUNKS=10
RAG_MIN_SCORE=0.30
RAG_MAX_CONTEXT_CHARS=24000

# ── Découpage ──────────────────────────────────────────────────
CHUNK_TARGET_TOKENS=1000
CHUNK_OVERLAP_TOKENS=120

# ── Ingestion ──────────────────────────────────────────────────
INGEST_BATCH_SIZE=32
INGEST_MAX_FILE_MB=512

# Dossier des livres et documents, en LECTURE SEULE. Joshua n'y écrit jamais.
#
# ── Exécution DANS Docker (recommandé) ────────────────────────
# Le conteneur ne voit pas l'arborescence du Mac : le dossier y est monté
# sous /library (voir docker-compose.override.yml.example). Ces variables
# doivent donc valoir /library, et le chemin réel du Mac est déclaré dans
# le fichier de surcouche, une seule fois.
#
# ── Exécution NATIVE sur le Mac (venv) ────────────────────────
# Renseigner le vrai chemin. Les guillemets sont nécessaires s'il contient
# des espaces :
#   JOSHUA_RBI_SOURCE="/Users/Mickael Darmon/Desktop/livres rbi"
#   JOSHUA_LIBRARY_PATH="/Users/moi/Library/Mobile Documents/com~apple~CloudDocs/Joshua"
#
# JOSHUA_RBI_SOURCE   : corpus du Rite       → category=rbi
# JOSHUA_LIBRARY_PATH : bibliothèque perso   → category=bibliotheque
# Deux catégories distinctes : c'est ce qui permet de restreindre une
# recherche aux seuls textes de l'Ordre.
JOSHUA_RBI_SOURCE=
JOSHUA_LIBRARY_PATH=

# ── Mémoire ────────────────────────────────────────────────────
MEMORY_RECENT_MESSAGES=20
MEMORY_SUMMARY_TRIGGER=40

# ── Sécurité ───────────────────────────────────────────────────
# Plusieurs identifiants séparés par des virgules. Obtenir le sien : @userinfobot
ADMIN_TELEGRAM_IDS=
MAX_USER_INPUT_CHARS=4000

# ── Divers ─────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_JSON=true
APP_ENV=dev
API_PORT=8000
